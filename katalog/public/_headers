# Cloudflare Workers static assets — headeri odgovora
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Vite assets imaju hash u imenu — smiju se keširati zauvijek
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Modeli i katalog nemaju hash: kratak cache da novi deploy brzo stigne
/modeli/*
  Cache-Control: public, max-age=3600
